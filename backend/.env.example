SECRET_KEY=change-me
DEBUG=true

# Add the IP of this Debian machine so you can use it from your Windows browser
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.64
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://192.168.1.64:8080

DB_NAME=app
DB_USER=app
DB_PASSWORD=app_dev_password
DB_HOST=db
DB_PORT=5432

# Used in links inside emails (verification, password reset)
FRONTEND_URL=http://localhost:8080
DEFAULT_FROM_EMAIL=web_foundation <noreply@localhost>
# Dev: Mailpit catches all email at http://localhost:8025. Leave EMAIL_HOST empty to print emails to the logs.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
MEDIA_SIGNED_URL_SECONDS=300

# To run several projects side by side on one dev machine, give each its own ports
# (then adjust FRONTEND_URL and CSRF_TRUSTED_ORIGINS to match):
# DEV_HTTP_PORT=8080
# DEV_MAIL_PORT=8025
